{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": ["server", "demo", "src", "vite.config.ts", "playwright.config.ts", "playwright.demo.config.ts", "tests"]
}
