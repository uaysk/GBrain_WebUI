# OpenAI-compatible endpoint used for Qwen embedding/reranking and model synthesis.
OPENAI_API_ENDPOINT=
OPENAI_API_KEY=

# Optional overrides.
GRAPHIFY_PROJECT=gbrain-webui
GRAPHIFY_EMBEDDING_MODEL=qwen3-embedding-4b
GRAPHIFY_RERANKER_MODEL=qwen3-reranker-4b
GRAPHIFY_SYNTHESIS_MODEL=gpt-5.3-codex-spark

# The shared Graphify CNPG database defaults are normally sufficient.
GRAPHIFY_PG_NAMESPACE=pg
GRAPHIFY_PG_SECRET=graphify-db
GRAPHIFY_PG_HOST=172.30.1.36
GRAPHIFY_PG_PORT=5432
GRAPHIFY_PG_DATABASE=graphify
GRAPHIFY_PG_SSL=disable

# TLS verifies the server certificate by default. Set a private CA when needed.
# GRAPHIFY_PG_SSL=require
# GRAPHIFY_PG_SSL_CA_FILE=/absolute/path/to/postgresql-ca.pem
# Only for explicitly accepted legacy endpoints; never enable by default.
# GRAPHIFY_PG_TLS_LEGACY_INSECURE=0
