{
  "name": "gbrain-3d-memory-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "bun run typecheck && bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build server/index.ts server/graph-build-worker.ts --target=bun --outdir=dist-server",
    "typecheck": "tsc -b",
    "lint": "bun scripts/lint-architecture.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test tests/architecture.test.ts tests/auth.test.ts tests/config.test.ts tests/http.test.ts tests/community.test.ts tests/community-labeling.test.ts tests/control-actions.test.ts tests/control-center.test.ts tests/control-client.test.ts tests/control-experience.test.ts tests/control-insights.test.ts tests/control-ui-state.test.ts tests/demo-memory.test.ts tests/dream-impact.test.ts tests/dream-inspector.test.ts tests/graph-history.test.ts tests/graph-layers.test.ts tests/graph-search-index.test.ts tests/graph-timeline.test.ts tests/interaction.test.ts tests/layout.test.ts tests/map-url-state.test.ts tests/rebuild-resilience.test.ts tests/rendering.test.ts tests/style.test.ts",
    "test:smoke": "bun test tests/smoke.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts e2e/control-center-live.spec.ts",
    "test:visual:live": "playwright test --config=playwright.live.config.ts e2e/visual.spec.ts",
    "verify:control-deployment": "bun run test:e2e:live",
    "benchmark:semantic": "bun scripts/semantic-candidate-benchmark.ts",
    "benchmark:graph": "bun scripts/graph-performance-benchmark.ts",
    "check:bundle": "bun scripts/check-bundle-boundaries.ts",
    "graphify:hybrid": "scripts/graphify-hybrid/run.sh",
    "graphify:setup": "scripts/graphify-hybrid/run.sh setup",
    "graphify:index": "scripts/graphify-hybrid/run.sh index --project gbrain-webui",
    "graphify:status": "scripts/graphify-hybrid/run.sh status --project gbrain-webui",
    "test:graphify": "bun test scripts/graphify-hybrid",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:graphify && bun run build:web && bun run check:bundle && bun run build:server",
    "deploy:control": "bash scripts/deploy-control-center.sh",
    "capture:readme-demo": "playwright test --config=playwright.demo.config.ts"
  },
  "dependencies": {
    "@aflsolutions/graphology-communities-leiden": "1.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "0.26.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-3d": "^1.29.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "three-spritetext": "^1.10.0",
    "umap-js": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "postcss": "8.5.18",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "postcss": "8.5.18"
  }
}
